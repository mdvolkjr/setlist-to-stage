rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Person level ──
    // A signed-in user fully owns their profile doc (users/{uid}) and every
    // sub-collection under it (songs, …). The nested match is required because
    // a recursive `{document=**}` on the parent does NOT cover the parent doc
    // itself — only its descendants.
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;

      match /{document=**} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }

    // ── Band level ──
    // Members share the band's Song List (repertoire) and setlists. Access is
    // by band membership. Band ids are random, unguessable capabilities, so we
    // let any signed-in user READ the band doc — that powers invite links and
    // the self-join flow. Sub-collections stay members-only.
    match /bands/{bandId} {
      allow create: if request.auth != null
        && request.auth.uid in request.resource.data.memberUids;

      // Read the band doc (name/members) by any signed-in user (invite links).
      allow read: if request.auth != null;

      allow update: if request.auth != null && (
        // Members can make any change.
        request.auth.uid in resource.data.memberUids
        // Self-join: a non-member may add ONLY themselves to memberUids,
        // without touching name/createdBy or removing anyone.
        || (
          !(request.auth.uid in resource.data.memberUids)
          && request.auth.uid in request.resource.data.memberUids
          && request.resource.data.memberUids.size() == resource.data.memberUids.size() + 1
          && request.resource.data.memberUids.hasAll(resource.data.memberUids)
          && request.resource.data.name == resource.data.name
          && request.resource.data.createdBy == resource.data.createdBy
        )
      );

      allow delete: if request.auth != null
        && request.auth.uid in resource.data.memberUids;

      match /{document=**} {
        allow read, write: if request.auth != null
          && request.auth.uid in
             get(/databases/$(database)/documents/bands/$(bandId)).data.memberUids;
      }
    }
  }
}
