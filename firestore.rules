rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Person level ──
    // A signed-in user fully owns their profile doc (users/{uid}) and every
    // sub-collection under it (songs, …). The nested match is required because
    // a recursive `{document=**}` on the parent does NOT cover the parent doc
    // itself — only its descendants.
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;

      match /{document=**} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }

    // ── Band level (built out in a later pass) ──
    // Only members of a band may read/write it and its sub-collections
    // (repertoire, setlists). Any signed-in user may create a new band.
    match /bands/{bandId} {
      allow create: if request.auth != null
        && request.auth.uid in request.resource.data.memberUids;
      allow read, update, delete: if request.auth != null
        && request.auth.uid in resource.data.memberUids;

      match /{document=**} {
        allow read, write: if request.auth != null
          && request.auth.uid in
             get(/databases/$(database)/documents/bands/$(bandId)).data.memberUids;
      }
    }
  }
}
